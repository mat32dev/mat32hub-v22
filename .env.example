# MAT32 Hub - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# REQUIRED: Gemini AI API Key
# ============================================
# Get your API key from: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get these from: https://supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# OPTIONAL: Social Media Integration
# ============================================
# Instagram Basic Display API
# Get from: https://developers.facebook.com
VITE_INSTAGRAM_TOKEN=your_instagram_token_here

# ============================================
# OPTIONAL: Google Services
# ============================================
# Google Calendar API
VITE_GOOGLE_CALENDAR_API_KEY=your_google_calendar_key_here

# Gmail API (for notifications)
VITE_GMAIL_API_KEY=your_gmail_api_key_here

# ============================================
# OPTIONAL: Analytics & Monitoring
# ============================================
# Vercel Analytics (auto-configured in Vercel)
# Google Analytics
VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================================
# OPTIONAL: Discogs Integration
# ============================================
# Discogs API for vinyl catalog
VITE_DISCOGS_TOKEN=your_discogs_token_here

# ============================================
# Development Settings
# ============================================
# Port for local development (default: 5173)
VITE_PORT=5173

# API Base URL (leave empty for production)
VITE_API_BASE_URL=

# ============================================
# NOTES:
# ============================================
# - Never commit .env.local to git
# - All VITE_ prefixed variables are exposed to the client
# - Non-VITE_ variables are server-side only
# - For production, set these in your hosting platform:
#   - Vercel: Project Settings > Environment Variables
#   - Replit: Secrets (lock icon in sidebar)
