
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. FORZAR HTTPS Y WWW
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.mat32.com/$1 [L,R=301]

  # 2. REDIRECCIONES 301 (Mapeo de archivos físicos antiguos a rutas SPA)
  RewriteRule ^index\.php$ / [L,R=301,NE]
  RewriteRule ^alquiler\.php$ /#/alquiler-local-eventos-valencia [L,R=301,NE]
  RewriteRule ^contacto\.php$ /#/contact [L,R=301,NE]
  RewriteRule ^eventos\.php$ /#/events [L,R=301,NE]
  RewriteRule ^tienda\.php$ /#/records [L,R=301,NE]
  
  # Redirecciones de rutas sin extensión antiguas
  RewriteRule ^alquiler-local-eventos-valencia$ /#/alquiler-local-eventos-valencia [L,R=301,NE]
  RewriteRule ^eventos$ /#/events [L,R=301,NE]
  RewriteRule ^tienda$ /#/records [L,R=301,NE]
  RewriteRule ^comunidad$ /#/community [L,R=301,NE]
  RewriteRule ^open-decks$ /#/open-decks [L,R=301,NE]
  RewriteRule ^opendecks$ /#/open-decks [L,R=301,NE]

  # 3. SPA ROUTING
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Aceleración de carga (Ranking Factor SEO)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
